# Copy to .env.local and change the values
# Long random string; used to sign in to /admin
ADMIN_TOKEN=change-me-to-a-long-random-string
# Optional: where bookings are stored (default: ./storage/db.json)
# DB_FILE=./storage/db.json
# Set to 1 behind a reverse proxy so rate limiting sees real client IPs
# TRUST_PROXY=1
